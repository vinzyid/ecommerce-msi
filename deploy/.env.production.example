# .env.production.example — template konfigurasi produksi VinzyPlay.
#
# Pakai (di VPS):
#   cp deploy/.env.production.example .env.production
#   nano .env.production
#
# Cara paling cepat: salin nilai dari .env di laptop untuk bagian DB_*, MAIL_*,
# GOOGLE_* dan CHATBOT_*. JANGAN commit .env.production (sudah di .gitignore).
#
# Ingat: tanpa tanda kutip, nilai tidak boleh mengandung spasi.

APP_NAME="VinzyPlay"
APP_ENV=production
# Hasilkan sekali:  php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# Jangan diganti setelah situs jalan (sesi & data terenkripsi jadi tidak terbaca).
APP_KEY=
APP_DEBUG=false
# Diisi otomatis oleh setup-vps.sh.
APP_URL=https://DOMAIN_VINZYPLAY

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database utama (Neon) — sama dengan di laptop ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_PERSISTENT=true

# --- Database kedua EIS (host & kredensial mengikuti DB_* bila dikosongkan) ---
DB_EIS_DATABASE=neondb_eis

# Sesi & cache disimpan di volume "storage", jadi tidak hilang saat deploy ulang.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# --- Email (Gmail SMTP + App Password 16 huruf TANPA spasi) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Login Google ---
# Di Google Cloud Console tambahkan Authorized redirect URI:
#   https://DOMAIN_VINZYPLAY/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://DOMAIN_VINZYPLAY/auth/google/callback

# --- Chatbot ---
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4o-mini
CHATBOT_TIMEOUT=30
CHATBOT_CACHE_TTL=60
CHATBOT_MAX_TOKENS=600
CHATBOT_TEMPERATURE=0.3
