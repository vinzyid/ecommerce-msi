# Dipasang ulang di dalam image.
vendor/
node_modules/
public/build/
public/hot

# Kredensial — diisi lewat .env.production saat runtime, bukan ditanam ke image.
.env
.env.*
!.env.example

.git/
.github/
.idea/
.vscode/
tests/
.phpunit.cache/
.phpunit.result.cache
storage/logs/
storage/framework/cache/data/
storage/framework/sessions/
storage/framework/views/
storage/app/
bootstrap/cache/*.php

# Unggahan pengguna disimpan di volume, bukan di image.
public/images/products/uploads/
public/images/reviews/

# Folder kerja & dokumen lokal.
image-web/
image-web-unik/
*.md
!README.md
Dockerfile
.dockerignore
docker-compose.yml
deploy/
deploy.sh
